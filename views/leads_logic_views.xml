<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leads_logic_form_whatsapp_lead_scheduler" model="ir.ui.view">
        <field name="name">leads.logic.form.whatsapp.lead.scheduler</field>
        <field name="model">leads.logic</field>
        <field name="inherit_id" ref="custom_leads_19.view_leads_logic_form"/>
        <field name="arch" type="xml">
            <!-- The one generic stage button - label and visibility come
                 entirely from otm.whatsapp.lead.stage.trigger (see
                 leads_logic.py._compute_whatsapp_stage_trigger). Sends
                 immediately, no confirmation, per spec. -->
            <xpath expr="//header[hasclass('o_lead_form_header')]/field[@name='state']" position="before">
                <button name="action_send_stage_whatsapp" type="object" class="btn-primary"
                        invisible="not whatsapp_stage_trigger_id" icon="fa-whatsapp">
                    <field name="whatsapp_stage_button_label"/>
                </button>
                <button name="action_open_whatsapp_schedule_wizard" type="object" string="Schedule WhatsApp"
                        invisible="not phone_number"/>
            </xpath>

            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_whatsapp_messages" type="object" class="oe_stat_button" icon="fa-clock-o">
                    <field name="whatsapp_message_count" widget="statinfo" string="WA Messages"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
