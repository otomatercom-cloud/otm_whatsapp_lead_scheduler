<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Same reasoning as otm_whatsapp_group_scheduler's own settings view:
         a small standalone screen rather than an unverified xpath into
         base.res_config_settings_view_form. -->
    <record id="view_whatsapp_lead_scheduler_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.whatsapp.lead.scheduler</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Lead Scheduler Settings">
                <sheet>
                    <group string="WhatsApp Lead Scheduler">
                        <field name="otm_lead_scheduler_enabled"/>
                        <field name="otm_lead_scheduler_batch_size"/>
                        <field name="otm_lead_scheduler_max_retry_count"/>
                    </group>
                    <group string="Reply Chatbot">
                        <field name="otm_lead_chatbot_enabled"/>
                        <field name="otm_lead_chatbot_ai_provider_id"/>
                        <field name="otm_lead_chatbot_fallback_message"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" type="object" name="execute" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_lead_scheduler_settings" model="ir.actions.act_window">
        <field name="name">Lead Scheduler Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_whatsapp_lead_scheduler_settings_form"/>
    </record>
</odoo>
