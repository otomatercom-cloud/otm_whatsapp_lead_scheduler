<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_lead_bot_form" model="ir.ui.view">
        <field name="name">otm.whatsapp.lead.bot.form</field>
        <field name="model">otm.whatsapp.lead.bot</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Lead Bot Connection">
                <header>
                    <button name="action_request_provisioning" type="object" string="Create Bot Instance"
                            class="btn-primary"
                            invisible="base_url or provision_state in ('requested', 'provisioning', 'done')"
                            help="Automatically creates this officer's own bot-service instance on the server (folder, port, PM2 process). Picked up by a background script - not instant."/>
                    <button name="action_check_connection" type="object" string="Check Connection" class="btn-secondary"/>
                    <button name="action_refresh_qr" type="object" string="Refresh QR Code" class="btn-secondary"
                            invisible="connection_state not in ('not_connected', 'qr_pending', 'error')"/>
                    <button name="action_request_removal" type="object" string="Remove Bot Instance"
                            class="btn-secondary" confirm="This will disconnect this officer immediately and permanently delete their WhatsApp pairing on the server. They will need to scan a fresh QR code if re-added later. Continue?"
                            invisible="not provision_slug or provision_state in ('requested', 'provisioning', 'removal_requested', 'removing', 'removed')"/>
                    <field name="connection_state" widget="statusbar" statusbar_visible="not_connected,qr_pending,connected"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        This connects to an <strong>unofficial</strong> WhatsApp Web automation service
                        (not Meta's Cloud API). Using it violates WhatsApp's Terms of Service and can get
                        the paired number banned - use a disposable number dedicated only to this officer,
                        never their Coexistence/Cloud API number. Each officer must have their OWN instance
                        of the bot service running on its own port - never share one instance/number
                        between two officers.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="provision_state not in ('requested', 'provisioning')">
                        Bot instance creation requested<span invisible="not provision_requested_date"> on <field name="provision_requested_date" nolabel="1" readonly="1"/></span>.
                        A background job on the server will create it automatically (usually within a few
                        minutes) and fill in the Service URL / API Token below. Refresh this record to check.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="provision_state != 'error'">
                        Automatic provisioning failed: <field name="provision_error" nolabel="1" readonly="1"/>
                        <br/>Fix the issue on the server, or fill in Service URL / API Token manually below,
                        then use Check Connection.
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="provision_state != 'done' or connection_state == 'connected'">
                        Bot instance created. Click <strong>Check Connection</strong> below, then have the
                        officer scan the QR code with their own phone.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="provision_state not in ('removal_requested', 'removing')">
                        Removal requested. A background job on the server will stop and delete this
                        officer's bot instance automatically (usually within a few minutes). This
                        connection is already deactivated and cannot send messages in the meantime.
                    </div>
                    <div class="alert alert-secondary" role="alert" invisible="provision_state != 'removed'">
                        This officer's bot instance has been removed from the server. Their WhatsApp
                        pairing was deleted - re-adding them later requires a fresh QR scan.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="provision_state != 'removal_error'">
                        Automatic removal failed: <field name="provision_error" nolabel="1" readonly="1"/>
                        <br/>Remove the instance manually on the server (teardown_officer_bot.sh), or
                        retry.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Lead Bot - Anjali"/></h1>
                    </div>
                    <group>
                        <group string="Officer &amp; Connection">
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="provision_slug" invisible="base_url"
                                   placeholder="auto-suggested from officer's login"/>
                            <!-- Deliberately NOT required at the view level (tried this once -
                                 see the model's base_url comment for why it's not required at
                                 the DB level either). Any "only when manually editing" condition
                                 also blocks the legitimate case of clearing an EXISTING record's
                                 Service URL/Token to retry Create Bot Instance - a real Odoo
                                 record already has an id, so an "id and ..." condition still
                                 fires and blocks the save before the button's logic runs. The
                                 functional check (a clear error from Check Connection / send if
                                 these are blank) is enough on its own. -->
                            <field name="base_url"/>
                            <field name="api_token" password="True"
                                   groups="otm_whatsapp_coexistence.group_whatsapp_administrator"/>
                            <field name="active"/>
                        </group>
                        <group string="Status">
                            <field name="provision_state" invisible="provision_state == 'none'"/>
                            <field name="phone_number"/>
                            <field name="last_check"/>
                            <field name="last_error" invisible="not last_error"/>
                        </group>
                    </group>
                    <group string="Pairing" invisible="connection_state != 'qr_pending' or not qr_image">
                        <field name="qr_image" widget="image" nolabel="1" options="{'size': [300, 300]}"/>
                        <div class="text-muted">
                            On the officer's own phone: WhatsApp &gt; Settings &gt; Linked Devices &gt; Link
                            a Device, then scan this code before it expires.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_lead_bot_list" model="ir.ui.view">
        <field name="name">otm.whatsapp.lead.bot.list</field>
        <field name="model">otm.whatsapp.lead.bot</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Lead Bot Connections">
                <field name="name"/>
                <field name="user_id"/>
                <field name="base_url"/>
                <field name="phone_number"/>
                <field name="provision_state" optional="hide"
                       decoration-warning="provision_state in ('requested', 'provisioning', 'removal_requested', 'removing')"
                       decoration-danger="provision_state in ('error', 'removal_error')"
                       decoration-muted="provision_state == 'removed'"/>
                <field name="connection_state" decoration-success="connection_state == 'connected'"
                       decoration-warning="connection_state == 'qr_pending'"
                       decoration-danger="connection_state == 'error'"/>
                <field name="last_check"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_whatsapp_lead_bot" model="ir.actions.act_window">
        <field name="name">Lead Bot Connections</field>
        <field name="res_model">otm.whatsapp.lead.bot</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect an Admission Officer's own WhatsApp number</p>
            <p>One record per officer. Point it at that officer's own running
                <code>otm-whatsapp-group-bot-service</code> instance (its own port/auth folder), then
                Check Connection and have them scan the QR code with their own phone.</p>
        </field>
    </record>
</odoo>
