<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_lead_template_form" model="ir.ui.view">
        <field name="name">otm.whatsapp.lead.template.form</field>
        <field name="model">otm.whatsapp.lead.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Lead Message Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Follow Up - No Response"/></h1>
                    </div>
                    <group>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Message">
                        <field name="body" nolabel="1"
                               placeholder="Hi {lead_name}, this is {officer_name} from Logic School..."/>
                        <div class="text-muted">
                            Placeholders: <code>{lead_name}</code>, <code>{phone_number}</code>,
                            <code>{course}</code>, <code>{place}</code>, <code>{college_name}</code>,
                            <code>{officer_name}</code>.
                        </div>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Internal notes - not sent."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_lead_template_list" model="ir.ui.view">
        <field name="name">otm.whatsapp.lead.template.list</field>
        <field name="model">otm.whatsapp.lead.template</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Lead Message Templates">
                <field name="name"/>
                <field name="body"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_whatsapp_lead_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">otm.whatsapp.lead.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a reusable WhatsApp template</p>
        </field>
    </record>
</odoo>
